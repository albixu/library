# ============================================================
# Library - Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed.
#
# This file contains configuration for:
#   - Production deployment (docker-compose.prod.yml)
#   - Testing environment (docker-compose.test.yml)
# ============================================================

# ============================================================
# PRODUCTION VARIABLES
# ============================================================

# ----- Required Variables -----
# PostgreSQL password for production database
# IMPORTANT: Change this to a secure password!
POSTGRES_PASSWORD=your_secure_password_here

# ----- Optional Variables -----

# API URL for web-client build (used at build time)
# This should be the URL where your API will be accessible
# Default: http://localhost:3000
API_URL=http://localhost:3000

# For VPS deployment, use your server's IP or domain:
# API_URL=http://192.168.1.100:3000
# API_URL=https://api.yourdomain.com

# ============================================================
# DEVELOPMENT VARIABLES (docker-compose.yml)
# ============================================================
# These are typically not needed as defaults are set in docker-compose.yml
# See apps/api/.env.example for development-specific variables

# ============================================================
# ENVIRONMENT REFERENCE
# ============================================================
#
# The following variables are used internally by docker-compose
# and generally don't need to be set in your .env file:
#
# | Variable           | Service     | Default                    | Description                       |
# |--------------------|-------------|----------------------------|-----------------------------------|
# | NODE_ENV           | api         | production                 | Application environment           |
# | PORT               | api         | 3000                       | API server port                   |
# | LOG_LEVEL          | api         | info                       | Logging level (debug/info/warn)   |
# | DATABASE_URL       | api         | (constructed from vars)    | PostgreSQL connection string      |
# | OLLAMA_BASE_URL    | api         | http://ollama:11434        | Ollama API endpoint               |
# | OLLAMA_MODEL       | api         | nomic-embed-text           | Model for embeddings              |
# | TRANSLATION_MODEL  | api         | qwen2.5:3b                 | Model for translations            |
# | POSTGRES_DB        | postgres    | library                    | Database name                     |
# | POSTGRES_USER      | postgres    | library                    | Database user                     |
#
# ============================================================
# PORTS REFERENCE
# ============================================================
#
# | Service     | Production | Testing | Development |
# |-------------|------------|---------|-------------|
# | web-client  | 80         | 4200    | 4200        |
# | api         | 3000       | 3001    | 3000        |
# | postgres    | (internal) | 5433    | 5432        |
# | ollama      | (internal) | 11435   | 11434       |
#
# ============================================================
