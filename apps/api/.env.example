# ================================
# Environment Variables
# ================================
# Copy this file to .env and adjust values as needed

# ----- Application -----
NODE_ENV=development
PORT=3000

# ----- Database -----
DATABASE_URL=postgresql://library:library@postgres:5432/library

# ----- Ollama (AI Models) -----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
TRANSLATION_MODEL=qwen2.5:3b

# ----- Logging -----
LOG_LEVEL=debug

# ----- Database Seeding -----
# Set to true to auto-seed database on startup if empty
AUTO_SEED=false
# Number of books to process per batch during seeding
BATCH_SIZE=50
# Max retries for embedding service failures during seeding
MAX_RETRIES=3

# ----- Email service (Gmail) -----
# Cuenta Gmail remitente para el envío de libros
GMAIL_USER=gmail-user
# Contraseña de aplicación de Google (no la contraseña normal de la cuenta)
# Generar en: Google Account > Seguridad > Contraseñas de aplicación
GMAIL_APP_PASSWORD=gmail-app-password

# ----- Authentication (JWT) -----
# Secret key for signing access tokens (min 32 chars)
JWT_SECRET=your-super-secret-key-min-32-chars
# Secret key for signing refresh tokens (min 32 chars, different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
# Hours until a password reset token expires (default: 24)
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
# Base URL of the web client (used for password reset links)
APP_BASE_URL=http://localhost:4200

# ----- Books file system -----
# Ruta absoluta en el host donde residen los archivos de los libros
# Los paths en la columna books.path son relativos a este directorio
# Dentro del contenedor se monta en /books
BOOKS_PATH=/ruta/a/tus/libros
